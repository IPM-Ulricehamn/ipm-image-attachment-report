#. Plugin Name of the plugin
#: image-attachment-report.php
msgid "IPM Image Attachment Report"
msgstr "IPM bildbilagerapport"

#. Description of the plugin
#: image-attachment-report.php
msgid ""
"Lists all image attachments, their usage, dimensions, and resolution "
"ranking. Includes CSV export."
msgstr ""
"Listar alla bildbilagor, var de används, dimensioner och "
"upplösningsklassning. Inkluderar export till CSV."

#. Author of the plugin
#: image-attachment-report.php
msgid "Erik Gripestam"
msgstr "Erik Gripestam"

#: admin-page.php:10
msgid "You do not have permission to view this page."
msgstr "Du saknar behörighet att visa den här sidan."

#: admin-page.php:16
msgid "Scan complete."
msgstr "Skanningen är klar."

#: admin-page.php:41
msgid "Image Attachment Report"
msgstr "Bildbilagerapport"

#: admin-page.php:46
msgid ""
"No report has been generated yet. Click \"Run scan\" above to build one."
msgstr ""
"Ingen rapport har genererats ännu. Klicka på \"Kör skanning\" ovan för att "
"skapa en."

#: admin-page.php:51
msgid "Export current list to CSV"
msgstr "Exportera aktuell lista till CSV"

